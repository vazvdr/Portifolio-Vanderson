{
  "compilerOptions": {
    "jsx": "react",
    "module": "Node16",
    "moduleResolution": "node16",  // Usando "node16" para resolver os módulos
    "target": "ESNext",  // Garantir que o JavaScript gerado seja moderno
    "esModuleInterop": true,  // Necessário para importações padrão de CommonJS
    "allowSyntheticDefaultImports": true,  // Permite importar módulos sem exportações padrão
    "strict": true,  // Para garantir o uso de tipos mais seguros
    "skipLibCheck": true,  // Ignorar verificação de tipo em arquivos de declaração
    "resolveJsonModule": true,  // Permite importar arquivos JSON como módulos

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
  ]
}
